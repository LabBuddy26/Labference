  "reports": [],
  "oracle_transports": ["text"],
  "replacement_sites": [],
  "reset": {"mode": "stateless"},
  "input_mapping": {
    "front": "camera_1_rgb",
    "wrist": "camera_3_rgb"
  },
  "strict_handshake": true,
  "receipt_required": true
}
