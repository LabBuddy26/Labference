{
  "schema_version": "labference/policy-profile-v1",
  "name": "openpi-franka-rack-recall-memory-rgb-v1",
  "system_type": "native_vla",
  "adapter": "openpi",
  "action": {
    "representation": "joint_position",
    "dimensions": 8,
    "mode": "absolute",
    "frame": "franka_joint",
    "units": "radians+normalized_gripper",
    "gripper": "symmetric_finger_position",
    "control_hz": 20.0,
    "max_chunk": 40
  },
  "sensors": {
    "rgb_channels": ["front", "wrist"],
    "depth_channels": [],
    "state_format": "franka_joint_positions"
  },
  "reports": [],
  "oracle_transports": ["text"],
  "replacement_sites": [],
  "reset": {
    "mode": "rpc",
    "clear_action_buffer": true,
    "clear_agent_context": true,
    "clear_episode_memory": true
  },
  "input_mapping": {
    "front": "camera_1_rgb",
    "wrist": "camera_3_rgb"
  },
  "episode_memory": "model_state",
  "history_protocol": "online_once",
  "strict_handshake": true,
  "receipt_required": true
}
